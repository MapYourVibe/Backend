NODE_ENV=development
PORT=4000

# --- Supabase Postgres ---
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT_REF.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# --- Redis (Upstash / Redis Cloud) ---
REDIS_URL="redis://default:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT"

# --- Auth ---
JWT_SECRET="replace-with-a-random-32+-character-secret"
JWT_EXPIRES_IN="7d"
COOKIE_DOMAIN="localhost"

# --- Razorpay ---
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxxxx"

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME="xxxxxxxx"
CLOUDINARY_API_KEY="xxxxxxxx"
CLOUDINARY_API_SECRET="xxxxxxxx"

# --- Email ---
EMAIL_FROM="tickets@yourbrand.com"
RESEND_API_KEY="xxxxxxxx"
